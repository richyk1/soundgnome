  "narrative": {
    "northStar": "The Instrument Panel",
    "overview": "Soundgnome is a music library that reads like a well-made instrument panel, not a streaming storefront. Retro yet professional, clean: a bare ground (pure black at night, white paper by day), hairline alpha rules carrying all structure, data set in Geist Mono, and pixel art as the only ornament. Every missing cover becomes a deterministic pixel sprite; every icon sits on a 24-unit pixel grid.\n\nDensity is operational: thousands of items in virtualized grids, two columns on a phone, six on desktop, with state readable at a glance (amber needs review, cyan is running or playing). The system refuses the category default: no glossy gradient cards, no blurred glass, no rounded pills.",
    "keyCharacteristics": [
      "Black/white ground with near-black/near-white surfaces and alpha hairlines.",
      "Geist for the interface, Geist Mono for counts, durations, dates, and small uppercase control labels.",
      "Two signals only: violet for what you chose, cyan for what is live; ink is the primary action.",
      "Pixelarticons at 16/24/48px; 15\u00d715 ordered-dither sprite covers; a pixel gnome mark.",
      "Flat at rest; shadows only on floating layers."
    ],
    "rules": [
      {
        "name": "The Two-Signal Rule",
        "body": "Violet marks what you chose; cyan marks what is live. Never swap them, and never use either as decoration.",
        "section": "colors"
      },
      {
        "name": "The Ink Key Rule",
        "body": "The primary action is solid ink (`--text-bright` on `--bg`), not a coloured button.",
        "section": "colors"
      },
      {
        "name": "The Glyph-Carries-Colour Rule",
        "body": "Sprite covers keep a neutral field; colour lives in the glyph only.",
        "section": "colors"
      },
      {
        "name": "The Mono-for-Data Rule",
        "body": "Geist Mono is for counts, durations, dates, and small uppercase control labels only; never for prose or headings.",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "No eyebrows above headings; the meta line sits beneath the title in mono.",
        "section": "typography"
      },
      {
        "name": "The 11px Floor",
        "body": "No text below 11px.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Nothing on the ground casts a shadow; if it floats, it gets `--float-shadow` and a `--float-border`.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use violet for chosen state and cyan for live state, nothing else.",
      "**Do** make the primary action an ink key (`--text-bright` on `--bg`).",
      "**Do** set counts, durations, and dates in Geist Mono with tabular numerals.",
      "**Do** use pixel icons at 16, 24, or 48px only.",
      "**Do** render missing covers with `PixelCover` and a stable seed.",
      "**Do** let the theme follow local time: day 07:00\u201319:00, night otherwise.",
      "**Do** keep touch targets at 44px and text at 11px or above."
    ],
    "donts": [
      "**Don't** use glossy gradient cards, blurred glass, or rounded pills.",
      "**Don't** put kickers or eyebrows above headings.",
      "**Don't** shadow anything that sits on the ground.",
      "**Don't** colour sprite fields; colour lives in the glyph.",
      "**Don't** use mono for prose or headings."
    ]
  }
}
